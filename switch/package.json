{
  "name": "silvershadow-pokerogue-switch",
  "version": "2.0.0",
  "private": true,
  "description": "SilverShadow PokeRogue nx.js V8 Milestone 2 real-game bootstrap",
  "type": "module",
  "scripts": {
    "clean": "node scripts/build-game.mjs --clean-output",
    "clean:output": "node scripts/build-game.mjs --clean-output",
    "clean:intermediate": "node scripts/build-game.mjs --clean-intermediate",
    "cache:clean": "node scripts/build-game.mjs --clean-all-cache",
    "cache:clean:upstream": "node scripts/build-game.mjs --clean-upstream-cache",
    "pregame:build": "node ../scripts/sync-daily-seed-archive.mjs",
    "game:build": "node scripts/build-game.mjs",
    "pregame:build:offline": "node ../scripts/sync-daily-seed-archive.mjs --offline",
    "game:build:offline": "node scripts/build-game.mjs --offline",
    "pregame:refresh": "node ../scripts/sync-daily-seed-archive.mjs",
    "game:refresh": "node scripts/build-game.mjs --refresh-upstream --refresh-assets --force-clean-checkout --rebuild-intermediate",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "nro": "node scripts/verify-icon.mjs && nxjs-nro --fat",
    "test:asset-packs": "node --test scripts/asset-pack.test.mjs",
    "test:runtime-safety": "node --test scripts/runtime-safety.test.mjs",
    "package": "npm run game:build && npm run typecheck && npm run test:asset-packs && npm run test:runtime-safety && npm run build && npm run nro && node scripts/package-release.mjs && node scripts/verify-release.mjs",
    "package:offline": "npm run game:build:offline && npm run typecheck && npm run test:asset-packs && npm run test:runtime-safety && npm run build && npm run nro && node scripts/package-release.mjs && node scripts/verify-release.mjs",
    "check": "npm run typecheck && npm run test:asset-packs && npm run test:runtime-safety && npm run build",
    "verify": "node scripts/verify-release.mjs"
  },
  "license": "MIT",
  "nacp": {
    "id": "01a5a17e5d010000",
    "title": "SilverShadow PokeRogue",
    "author": "SilverShadow"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@nx.js/nro": "1.0.0-beta.6",
    "@nx.js/runtime": "1.0.0-beta.6",
    "esbuild": "0.28.1",
    "fflate": "0.8.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
